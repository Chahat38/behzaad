# Supabase (free tier) — project settings
# Dashboard: https://supabase.com/dashboard -> Project Settings -> API
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional: Resend API key for transactional email alerts (server-only, later step)
RESEND_API_KEY=

# Whitelisted admin emails (comma separated) allowed into /admin
ADMIN_EMAILS=behzadqureshiscience@gmail.com
